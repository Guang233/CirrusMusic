{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "cirrusExecutable",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "appCirrusMusic"
            }
        },
        {
            "id": "galleryExecutable",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "appCirrusGallery"
            }
        },
        {
            "id": "galleryPage",
            "type": "pickString",
            "description": "Gallery 页面",
            "options": [
                {
                    "label": "上次的页面",
                    "value": ""
                },
                {
                    "label": "theme（主题）",
                    "value": "theme"
                },
                {
                    "label": "buttons（按钮）",
                    "value": "buttons"
                },
                {
                    "label": "inputs（选择与输入）",
                    "value": "inputs"
                },
                {
                    "label": "progress（进度）",
                    "value": "progress"
                },
                {
                    "label": "lists（列表与菜单）",
                    "value": "lists"
                },
                {
                    "label": "resources（资源）",
                    "value": "resources"
                }
            ],
            "default": ""
        }
    ],
    "configurations": [
        {
            "name": "Cirrus: Debug (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:cirrusExecutable}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Cirrus: build",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Gallery: Debug (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:galleryExecutable}",
            "args": [
                "--page",
                "${input:galleryPage}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Gallery: build",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}