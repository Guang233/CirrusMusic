{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cirrus: configure",
            "type": "cmake",
            "command": "configure",
            "problemMatcher": [],
            "detail": "Configure the selected CMake preset."
        },
        {
            "label": "Cirrus: build",
            "type": "cmake",
            "command": "build",
            "targets": ["all"],
            "dependsOn": ["Cirrus: configure"],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the app, backend libraries and enabled tests with the selected preset (Ctrl+Shift+B)."
        },
        {
            "label": "Cirrus: test",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir", "${command:cmake.buildDirectory}",
                "--output-on-failure", "--no-tests=error"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": ["Cirrus: build"],
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": [],
            "detail": "Build first, then run CTest in the active configure preset directory; requires BUILD_TESTING=ON."
        },
        {
            "label": "Cirrus: qmllint",
            "type": "cmake",
            "command": "build",
            "targets": ["all_qmllint"],
            "dependsOn": ["Cirrus: configure"],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "detail": "Run the Qt-generated QML lint target with module import paths."
        },
        {
            "label": "Cirrus: clean",
            "type": "cmake",
            "command": "clean",
            "problemMatcher": []
        }
    ]
}
