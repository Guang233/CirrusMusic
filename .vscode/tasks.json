{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cirrus: configure",
            "type": "cmake",
            "command": "configure",
            "problemMatcher": [],
            "detail": "Configure the selected CMake preset."
        },
        {
            "label": "Cirrus: build",
            "type": "cmake",
            "command": "build",
            "targets": [
                "all"
            ],
            "dependsOn": [
                "Cirrus: configure"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build the app, backend libraries and enabled tests with the selected preset (Ctrl+Shift+B)."
        },
        {
            "label": "Cirrus: test",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${command:cmake.buildDirectory}",
                "--output-on-failure",
                "--no-tests=error"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Cirrus: build"
            ],
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": [],
            "detail": "Build first, then run CTest in the active configure preset directory; requires BUILD_TESTING=ON."
        },
        {
            "label": "Cirrus: qmllint",
            "type": "cmake",
            "command": "build",
            "targets": [
                "all_qmllint"
            ],
            "dependsOn": [
                "Cirrus: configure"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "detail": "Run the Qt-generated QML lint target with module import paths."
        },
        {
            "label": "Cirrus: clean",
            "type": "cmake",
            "command": "clean",
            "problemMatcher": []
        },
        {
            "label": "Gallery: build",
            "type": "cmake",
            "command": "build",
            "targets": [
                "appCirrusGallery"
            ],
            "dependsOn": [
                "Cirrus: configure"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build only the UI gallery with the selected preset."
        },
        {
            "label": "Gallery: run",
            "type": "process",
            "command": "${command:cmake.buildDirectory}/appCirrusGallery",
            "args": [
                "--page",
                "${input:galleryPage}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Gallery: build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "detail": "Build, then open the gallery (reopens the last page, cover and mode unless a page is picked)."
        },
        {
            "label": "Gallery: watch",
            "type": "process",
            "command": "${workspaceFolder}/tools/ui/gallery-watch.sh",
            "args": [
                "--page",
                "${input:galleryPage}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PRESET": "${command:cmake.activeConfigurePresetName}"
                }
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Live preview: rebuild on every UI source change and restart the gallery (needs inotify-tools). Stop with the trash icon or Ctrl+C."
        },
        {
            "label": "Gallery: screenshot",
            "type": "shell",
            "command": "mkdir -p build/gallery-shots && QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=${input:galleryRenderer} QSG_RHI_BACKEND=opengl '${command:cmake.buildDirectory}/appCirrusGallery' --page ${input:galleryShotPage} --mode ${input:galleryMode} --size ${input:gallerySize} --grab build/gallery-shots/${input:galleryShotPage}-${input:galleryMode}-${input:galleryRenderer}.png && code -r build/gallery-shots/${input:galleryShotPage}-${input:galleryMode}-${input:galleryRenderer}.png",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Gallery: build"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "detail": "Headless screenshot of one gallery page into build/gallery-shots/, opened in the editor."
        }
    ],
    "inputs": [
        {
            "id": "galleryPage",
            "type": "pickString",
            "description": "Gallery 页面",
            "options": [
                {
                    "label": "上次的页面",
                    "value": ""
                },
                {
                    "label": "theme（主题）",
                    "value": "theme"
                },
                {
                    "label": "buttons（按钮）",
                    "value": "buttons"
                },
                {
                    "label": "inputs（选择与输入）",
                    "value": "inputs"
                },
                {
                    "label": "progress（进度）",
                    "value": "progress"
                },
                {
                    "label": "lists（列表与菜单）",
                    "value": "lists"
                },
                {
                    "label": "resources（资源）",
                    "value": "resources"
                }
            ],
            "default": ""
        },
        {
            "id": "galleryShotPage",
            "type": "pickString",
            "description": "截图页面",
            "options": [
                {
                    "label": "theme（主题）",
                    "value": "theme"
                },
                {
                    "label": "buttons（按钮）",
                    "value": "buttons"
                },
                {
                    "label": "inputs（选择与输入）",
                    "value": "inputs"
                },
                {
                    "label": "progress（进度）",
                    "value": "progress"
                },
                {
                    "label": "lists（列表与菜单）",
                    "value": "lists"
                },
                {
                    "label": "resources（资源）",
                    "value": "resources"
                }
            ],
            "default": "buttons"
        },
        {
            "id": "galleryMode",
            "type": "pickString",
            "description": "明暗",
            "options": [
                "light",
                "dark"
            ],
            "default": "light"
        },
        {
            "id": "galleryRenderer",
            "type": "pickString",
            "description": "渲染后端（software 用于检查无 GPU 时的降级）",
            "options": [
                {
                    "label": "rhi（OpenGL，着色器效果可见）",
                    "value": "rhi"
                },
                {
                    "label": "software",
                    "value": "software"
                }
            ],
            "default": "rhi"
        },
        {
            "id": "gallerySize",
            "type": "promptString",
            "description": "窗口尺寸 WxH",
            "default": "1280x2400"
        }
    ]
}